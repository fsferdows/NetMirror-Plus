{
  "name": "moviebox-web",
  "version": "1.0.0",
  "description": "NetMirror-style Cinema Web Streaming & In-Browser Player for MovieBox",
  "main": "web/index.html",
  "scripts": {
    "start": "cargo run --release --bin moviebox_web",
    "dev": "cargo run --bin moviebox_web",
    "build": "echo 'MovieBox Plus static build ready in web/'",
    "build:rust": "cargo build --release --bin moviebox_web",
    "netlify:build": "netlify build",
    "netlify:deploy": "netlify deploy",
    "netlify:prod": "netlify deploy --prod",
    "vercel:dev": "vercel dev",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel",
    "vercel:prod": "vercel --prod"
  },
  "keywords": [
    "moviebox",
    "netmirror",
    "streaming",
    "video-player",
    "movies",
    "cinema"
  ],
  "license": "MIT",
  "devDependencies": {
    "vercel": "^65.16.0"
  }
}
